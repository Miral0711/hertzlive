generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Fresh minimal auth model. Not tied to the prototype's fictional seed data.
enum Role {
  partner
  designer
  site_manager
  hr
  client
  contractor
}

// White-label foundation: every user belongs to exactly one organization (tenant).
// Only one organization exists today (the "hertz-demo" seed below), but every query
// that touches users/projects/etc. should already be scoped by organizationId so a
// second tenant can be added later without restructuring auth.
model Organization {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  logo          String?
  primaryColor  String?
  secondaryColor String?
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users User[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  passwordHash   String
  name           String
  role           Role         @default(designer)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("users")
}
