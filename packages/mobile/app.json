{
  "expo": {
    "name": "Hertz Studio",
    "slug": "hertz-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hertz.studio"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hertz.studio"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Hertz Studio uses the camera to take site photos.",
          "microphonePermission": "Hertz Studio uses the microphone for voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hertz Studio lets you attach photos to chats."
        }
      ]
    ]
  }
}